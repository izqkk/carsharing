# Copy to `.env` and fill in. `.env` is git-ignored.
#
# ---------------------------------------------------------------------------
# READ THIS FIRST
#
# Everything prefixed with VITE_ is compiled into the JavaScript bundle and is
# therefore PUBLIC -- anyone who opens the site can read it. That is fine for
# the values below and by design for the Supabase anon key, which is only ever
# as powerful as your Row Level Security policies allow.
#
# NEVER put a Supabase service_role key, a database password, or any other
# secret in this file. There is no VITE_ variable that stays private.
#
# These values are read at BUILD time, not at runtime: after changing them you
# have to rebuild (`npm run build`) or restart the dev server.
# ---------------------------------------------------------------------------


# --- Required: Supabase connection -----------------------------------------
# Dashboard -> Project Settings -> Data API
# Without these the app still loads, but shows a "not configured" notice
# instead of letting anyone sign in.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key


# --- Optional: branding -----------------------------------------------------
# Shown in the browser tab, on the sign-in screen and in the installed PWA.
# Defaults: "Carshare" / "Shared-car booking for small groups".

# VITE_APP_NAME=Carshare
# VITE_APP_DESCRIPTION=Shared-car booking for small groups


# --- Optional: language -----------------------------------------------------
# Which language a first-time visitor sees: `en` or `de`. Anyone can change it
# in the app afterwards, and their choice is remembered per device.
# Unset, the app follows the browser's language and falls back to English.

# VITE_DEFAULT_LOCALE=en
